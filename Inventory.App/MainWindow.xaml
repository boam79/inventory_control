<Window x:Class="Inventory.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="스프링의원 재고관리"
        Height="768" Width="1366"
        MinHeight="600" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ClinicCanvasBrush}">
    <DockPanel x:Name="RootPanel">
        <Border DockPanel.Dock="Bottom" Padding="28,6" Background="White"
                BorderBrush="{StaticResource ClinicLineBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusBarLeft" FontSize="11"
                           Foreground="{StaticResource ClinicTextSecondaryBrush}"/>
                <TextBlock x:Name="StatusBarRight" Grid.Column="1" FontSize="11"
                           Foreground="{StaticResource ClinicTextSecondaryBrush}"/>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Top" Padding="28,18,28,12" Background="White"
                BorderBrush="{StaticResource ClinicLineBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="스프링의원" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource ClinicTextPrimaryBrush}"/>
                        <TextBlock Text="재고관리" FontSize="14" FontWeight="Normal"
                                   Foreground="{StaticResource ClinicTextSecondaryBrush}"
                                   VerticalAlignment="Bottom" Margin="10,0,0,3"/>
                    </StackPanel>
                    <TextBlock x:Name="PageTitle" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource ClinicAccentBrush}"
                               Margin="0,6,0,0" Text="대시보드"/>
                    <TextBlock x:Name="PageHint" Margin="0,4,0,0" FontSize="13"
                               Foreground="{StaticResource ClinicTextSecondaryBrush}" Text="로컬 · 오프라인"/>
                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock x:Name="UserLabel" FontSize="12"
                                   Foreground="{StaticResource ClinicTextSecondaryBrush}" Margin="0,0,16,0"/>
                        <TextBlock x:Name="PeriodLabel" FontSize="12"
                                   Foreground="{StaticResource ClinicTextSecondaryBrush}" Margin="0,0,16,0"/>
                        <TextBlock x:Name="ShortcutHint" FontSize="11"
                                   Foreground="{StaticResource ClinicTextSecondaryBrush}"
                                   Text="Ctrl+1 입고 · Ctrl+2 출고 · F5 새로고침"/>
                    </WrapPanel>
                    <TextBlock x:Name="AlertLabel" Margin="0,6,0,0" FontSize="12"
                               Foreground="{StaticResource ClinicAccentBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <StackPanel x:Name="NavPanel" HorizontalAlignment="Right"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button x:Name="UpdateButton" Content="업데이트" Style="{StaticResource GhostButton}"
                                Click="Update_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto" Background="{StaticResource ClinicCanvasBrush}">
            <ContentControl x:Name="MainContent" Margin="28,16,28,20"
                            HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
        </ScrollViewer>
    </DockPanel>
</Window>
