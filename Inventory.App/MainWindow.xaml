<Window x:Class="Inventory.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="스프링의원 재고관리"
        Height="768" Width="1366"
        MinHeight="600" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#EEF1F4">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="14,10" Background="#2F3E4D">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center">
                    <Border Style="{StaticResource HeaderChip}">
                        <TextBlock x:Name="UserLabel" Style="{StaticResource HeaderText}"/>
                    </Border>
                    <Border Style="{StaticResource HeaderChip}">
                        <TextBlock x:Name="PeriodLabel" Style="{StaticResource HeaderText}"/>
                    </Border>
                    <Border x:Name="AlertChip" Style="{StaticResource HeaderChip}" MaxWidth="520">
                        <TextBlock x:Name="AlertLabel" Style="{StaticResource HeaderText}" TextWrapping="Wrap"/>
                    </Border>
                    <Border Style="{StaticResource HeaderChip}">
                        <TextBlock x:Name="VersionLabel" Style="{StaticResource HeaderText}"/>
                    </Border>
                </WrapPanel>
                <Button x:Name="LogoutButton" Grid.Column="1" Content="로그아웃"
                        Padding="14,6" VerticalAlignment="Center" Click="Logout_Click"/>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Left" Background="#F7F8FA" BorderBrush="#D8DEE4" BorderThickness="0,0,1,0">
            <ListBox x:Name="MenuList" Style="{StaticResource ShellMenuList}"
                     SelectionChanged="MenuList_SelectionChanged"/>
        </Border>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="#EEF1F4">
            <ContentControl x:Name="MainContent" Margin="16" MinWidth="900"/>
        </ScrollViewer>
    </DockPanel>
</Window>
