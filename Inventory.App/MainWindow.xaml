<Window x:Class="Inventory.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="스프링의원 재고관리"
        Height="768" Width="1366"
        MinHeight="600" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ClinicCanvasBrush}">
    <DockPanel x:Name="RootPanel">
        <Border DockPanel.Dock="Bottom" Padding="28,6" Background="White"
                BorderBrush="{StaticResource ClinicLineBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusBarLeft" FontSize="11"
                           Foreground="{StaticResource ClinicTextSecondaryBrush}"/>
                <TextBlock x:Name="StatusBarRight" Grid.Column="1" FontSize="11"
                           Foreground="{StaticResource ClinicTextSecondaryBrush}"/>
            </Grid>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource ClinicMenuBrush}"
                    BorderBrush="{StaticResource ClinicLineBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource ClinicAccentBrush}" Padding="14,14,14,12">
                        <StackPanel>
                            <TextBlock Text="스프링의원" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="재고관리" FontSize="11" Foreground="#D7E8E8" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="NavPanel" Margin="0,8,0,12"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <DockPanel Grid.Column="1">
                <Border DockPanel.Dock="Top" Padding="20,14,28,10" Background="White"
                        BorderBrush="{StaticResource ClinicLineBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitle" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource ClinicAccentBrush}" Text="대시보드"/>
                            <TextBlock x:Name="PageHint" Margin="0,2,0,0" FontSize="12"
                                       Foreground="{StaticResource ClinicTextSecondaryBrush}" Text="로컬 · 오프라인"/>
                            <WrapPanel Margin="0,4,0,0">
                                <TextBlock x:Name="UserLabel" FontSize="11"
                                           Foreground="{StaticResource ClinicTextSecondaryBrush}" Margin="0,0,12,0"/>
                                <TextBlock x:Name="PeriodLabel" FontSize="11"
                                           Foreground="{StaticResource ClinicTextSecondaryBrush}" Margin="0,0,12,0"/>
                                <TextBlock x:Name="ShortcutHint" FontSize="10"
                                           Foreground="{StaticResource ClinicTextSecondaryBrush}"
                                           Text="Ctrl+1 입고 · Ctrl+2 출고 · F5 새로고침"/>
                            </WrapPanel>
                            <TextBlock x:Name="AlertLabel" Margin="0,4,0,0" FontSize="11"
                                       Foreground="{StaticResource ClinicAccentBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button x:Name="UpdateButton" Content="업데이트" Style="{StaticResource GhostButton}"
                                    Click="Update_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto" Background="{StaticResource ClinicCanvasBrush}">
                    <ContentControl x:Name="MainContent" Margin="20,14,28,20"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
