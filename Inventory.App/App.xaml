<Application x:Class="Inventory.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <sys:Double x:Key="AppFontScale">1.0</sys:Double>
        <CornerRadius x:Key="CornerRadiusSmall">4</CornerRadius>
        <CornerRadius x:Key="CornerRadiusMedium">8</CornerRadius>
        <CornerRadius x:Key="CornerRadiusLarge">12</CornerRadius>
        <SolidColorBrush x:Key="ClinicHeaderBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ClinicHeaderChipBrush" Color="#E8EEF0"/>
        <SolidColorBrush x:Key="ClinicCanvasBrush" Color="#F3F5F6"/>
        <SolidColorBrush x:Key="ClinicMenuBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ClinicLineBrush" Color="#E2E8EA"/>
        <SolidColorBrush x:Key="ClinicSelectBrush" Color="#D7E8E8"/>
        <SolidColorBrush x:Key="ClinicAccentBrush" Color="#1F6F73"/>
        <SolidColorBrush x:Key="ClinicDangerBrush" Color="#C0392B"/>
        <SolidColorBrush x:Key="ClinicWarnBrush" Color="#C47B16"/>
        <SolidColorBrush x:Key="ClinicWarnSoftBrush" Color="#FFF4E0"/>
        <SolidColorBrush x:Key="ClinicTextPrimaryBrush" Color="#1A2330"/>
        <SolidColorBrush x:Key="ClinicTextSecondaryBrush" Color="#6B7A86"/>
        <SolidColorBrush x:Key="ClinicTextBodyBrush" Color="#334155"/>
        <SolidColorBrush x:Key="ClinicGhostBgBrush" Color="#EEF1F2"/>
        <SolidColorBrush x:Key="ClinicGhostBorderBrush" Color="#D5DCE0"/>
        <SolidColorBrush x:Key="ClinicRowAltBrush" Color="#F8FAFA"/>
        <SolidColorBrush x:Key="ClinicRowWarnBrush" Color="#FFF4E0"/>
        <SolidColorBrush x:Key="ClinicRowDangerBrush" Color="#FCEBE9"/>
        <SolidColorBrush x:Key="ClinicCardBorderBrush" Color="#D8DEE4"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource ClinicAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ClinicAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource CornerRadiusMedium}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource ClinicAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource ClinicAccentBrush}"/>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource ClinicGhostBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ClinicTextBodyBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ClinicGhostBorderBrush}"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource ClinicDangerBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource ClinicDangerBrush}"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,6,4"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style x:Key="NavButtonActive" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Background" Value="{StaticResource ClinicAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="FilterChip" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="56"/>
        </Style>
        <Style x:Key="FilterChipActive" TargetType="Button" BasedOn="{StaticResource FilterChip}">
            <Setter Property="Background" Value="{StaticResource ClinicSelectBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ClinicAccentBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="{StaticResource ClinicAccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="HeaderChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ClinicHeaderChipBrush}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMedium}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ClinicTextBodyBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="BorderBrush" Value="{StaticResource ClinicLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="ColumnHeaderHeight" Value="34"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource ClinicRowAltBrush}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF2F3"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="BorderBrush" Value="{StaticResource ClinicGhostBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
    </Application.Resources>
</Application>
